<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/ly_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_roundedrect_primary_light"
        android:layout_marginLeft="@dimen/_20sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_10sdp"
        app:cardCornerRadius="@dimen/_10sdp">

        <LinearLayout
            android:id="@+id/llItem"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/round_rect_item_list"
            android:paddingLeft="@dimen/_15sdp"
            android:paddingRight="@dimen/_15sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:paddingTop="@dimen/_8sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dip"
                android:textSize="@dimen/_16sdp"
                android:textStyle="bold" >
            </TextView>

            <LinearLayout
                android:id="@+id/llReported"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:layout_gravity="right"
                android:visibility="gone"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_gravity="center_vertical"
                    android:backgroundTint="@color/green_active"
                    android:foregroundTint="@color/green_active"
                    android:src="@drawable/ic_checked"
                    app:tint="@color/green_active" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_2sdp"
                    android:padding="10dip"
                    android:text="Reported"
                    android:textColor="@color/green_active"
                    android:textSize="@dimen/_13sdp"
                    android:textStyle="bold" >
                </TextView>

            </LinearLayout>

            <Button
                android:id="@+id/btnAssign"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_26sdp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_border_box"
                android:layout_marginTop="@dimen/_10sdp"
                android:paddingLeft="@dimen/_20sdp"
                android:paddingRight="@dimen/_20sdp"
                android:text="Assign to Cardiologist"
                android:textAllCaps="false"
                android:visibility="gone"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
