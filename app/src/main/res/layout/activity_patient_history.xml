<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_100sdp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center_vertical"
                android:backgroundTint="@color/white"
                android:foregroundTint="@color/white"
                android:padding="6dp"
                android:src="@drawable/backs"
                app:tint="@color/colorWhite" />

            <TextView
                android:id="@+id/header_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_minus16sdp"
                android:gravity="top|center_horizontal"
                android:text="Add Patient History"
                android:textColor="@color/white"
                android:fontFamily="@font/regular"
                android:textSize="@dimen/_18sdp" />

        </LinearLayout>

    </FrameLayout>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/_minus30sdp"
        android:background="@drawable/round_rect_header"
        android:paddingTop="@dimen/_10sdp"
        tools:context=".MainActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Patient ID -->
            <TextView android:layout_marginTop="@dimen/_10sdp" style="@style/TitleStyle" android:text="History Notes" />
            <EditText
                style="@style/InputStyle"
                android:id="@+id/etHistoryNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:maxLines="3"
                android:gravity="top"
                android:scrollbars="vertical"/>

            <!-- First Name -->
            <TextView android:layout_marginTop="@dimen/_10sdp" style="@style/TitleStyle" android:text="Referring Doctor Name" />
            <EditText style="@style/InputStyle" android:id="@+id/etDoctorName" android:inputType="textCapSentences"/>

        </LinearLayout>
    </ScrollView>

    <!-- Register Button -->
    <Button
        android:id="@+id/btnAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add History"
        android:textSize="18sp"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@android:color/white"
        android:padding="@dimen/_13sdp"
        android:layout_marginTop="20dp"/>
</LinearLayout>

