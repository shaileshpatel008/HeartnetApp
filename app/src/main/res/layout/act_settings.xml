<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_100sdp"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/header_left_btn"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center_vertical"
                    android:backgroundTint="@color/white"
                    android:foregroundTint="@color/white"
                    android:padding="6dp"
                    android:src="@drawable/backs"
                    app:tint="@color/colorWhite" />

                <TextView
                    android:id="@+id/header_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_minus16sdp"
                    android:gravity="top|center_horizontal"
                    android:text="SETTINGS"
                    android:textColor="@color/white"
                    android:fontFamily="@font/regular"
                    android:textSize="@dimen/_15sdp" />

            </LinearLayout>

        </FrameLayout>

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/settingsToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:padding="@dimen/padding"
            app:layout_constraintBottom_toTopOf="@id/scrollabaleContent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/backs"
            app:title="Settings"
            android:visibility="gone"
            app:titleTextAppearance="@style/TitleText">

        </androidx.appcompat.widget.Toolbar>


        <ScrollView
            android:id="@+id/scrollabaleContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/_minus30sdp"
            android:background="@drawable/round_rect_header"
            android:scrollbarThumbVertical="@android:color/black"
            app:layout_constraintBottom_toTopOf="@id/settings_save"
            app:layout_constraintTop_toBottomOf="@id/settingsToolbar">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!--<TextView
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:padding="@dimen/_5sdp"
                    android:text="@string/app_settings"
                    android:textStyle="bold"
                    android:background="@color/colorPrimaryLight"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_15sdp" />-->

                <LinearLayout
                    android:id="@+id/llSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/_20sdp"
                    android:paddingRight="@dimen/_20sdp"
                    android:paddingBottom="@dimen/_10sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:weightSum="3">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/verson"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/settings_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="@dimen/_5sdp"
                            android:background="@color/colorPrimaryLight"
                            android:textSize="@dimen/_14sdp" />

                    </LinearLayout>

                    <!--<View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray"
                        android:layout_marginTop="@dimen/_10sdp"/>-->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/settings_language_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/language_label"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <Spinner
                            android:id="@+id/spinner_language"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="@dimen/_5sdp"
                            android:background="@color/colorPrimaryLight"
                            android:textSize="@dimen/_14sdp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/settings_change_filter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/filter"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <Spinner
                            android:id="@+id/spinner_filter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="@dimen/_5sdp"
                            android:background="@color/colorPrimaryLight"
                            android:textSize="@dimen/_14sdp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/settings_change_gain"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/gain"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <Spinner
                            android:id="@+id/spinner_gain"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2"
                            android:padding="@dimen/_5sdp"
                            android:background="@color/colorPrimaryLight"
                            android:textSize="@dimen/_14sdp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:weightSum="9">

                        <TextView
                            android:id="@+id/settings_change_report"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/reports"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:background="@color/colorPrimaryLight"
                            android:layout_weight="6"
                            android:orientation="horizontal" >

                            <TextView
                                android:id="@+id/alert_report"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="5"
                                android:padding="@dimen/_5sdp"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_14sdp" />

                            <ImageView
                                android:id="@+id/alert_report_arrow"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:src="@drawable/ic_baseline_chevron_right_24" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:weightSum="9">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/csv_label"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />


                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_csv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.6"
                            android:checked="false"
                            android:padding="@dimen/_5sdp"
                            android:textSize="@dimen/_14sdp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/operating_mode"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.davidmiguel.multistateswitch.MultiStateSwitch
                                android:id="@+id/mstb_multi_id"
                                android:layout_width="@dimen/_200sdp"
                                android:layout_height="55dp"
                                android:layout_marginTop="8dp"
                                app:multistateswitch_background_color="@color/colorWhite"
                                app:multistateswitch_disabled_background_color="@color/colorGray"
                                app:multistateswitch_selected_background_color="@color/colorPrimary"
                                app:multistateswitch_selected_text_color="@color/colorWhite"
                                app:multistateswitch_disabled_text_color="@color/colorBlack" />

                            <TextView
                                android:id="@+id/tvSelected"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center|start"
                                android:padding="@dimen/_5sdp"
                                android:text="You selected ECG Mode"
                                android:textColor="@color/darkGrey"
                                android:textSize="@dimen/_11sdp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.4"
                            android:gravity="end"
                            android:text="@string/mode_ecg"
                            android:textAlignment="textEnd"
                            android:textColor="@color/black"
                            android:visibility="gone"
                            android:textSize="@dimen/_14sdp"></TextView>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/settings_test_mode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.6"
                            android:checked="false"
                            android:visibility="gone"
                            android:padding="@dimen/_5sdp"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.4"
                            android:text="@string/mode_test"
                            android:visibility="gone"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp"></TextView>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPatientInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/_20sdp"
                    android:paddingRight="@dimen/_20sdp"
                    android:paddingTop="@dimen/_10sdp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/personalization"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:background="@color/colorPrimaryLight"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_15sdp" />

                    <RelativeLayout
                        android:layout_width="@dimen/toolbar_profile_width"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_gravity="center">

                        <com.mikhaellopez.circularimageview.CircularImageView
                            android:id="@+id/img_profile"
                            android:layout_width="@dimen/toolbar_profile_width"
                            android:layout_height="@dimen/toolbar_profile_width"
                            android:layout_marginTop="@dimen/activity_padding"
                            android:layout_marginBottom="@dimen/activity_padding"
                            android:scaleType="centerInside"
                            android:src="@mipmap/ic_launcher"
                            app:civ_border_color="@android:color/white"
                            app:civ_border_width="2dp" />

                        <com.mikhaellopez.circularimageview.CircularImageView
                            android:id="@+id/img_plus"
                            android:layout_width="@dimen/ic_plus_width"
                            android:layout_height="@dimen/ic_plus_width"
                            android:layout_alignBottom="@id/img_profile"
                            android:layout_alignParentRight="true"
                            android:src="@android:drawable/btn_plus"
                            app:civ_shadow="true"
                            app:civ_shadow_radius="1dp" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:orientation="vertical" >

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center|start"
                            android:text="Doctor's Signature"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <com.williamww.silkysignature.views.SignaturePad
                            android:id="@+id/signature_pad"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:background="@color/gray"
                            app:penColor="@android:color/black" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/buttons_container"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:orientation="horizontal"
                        android:paddingTop="0dp">

                        <Button
                            android:id="@+id/clear_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/white"
                            android:singleLine="true"
                            android:layout_weight="1"
                            android:background="@android:color/holo_red_light"
                            android:enabled="false"
                            android:text="Clear" />

                        <Button
                            android:id="@+id/compress_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_weight="1"
                            android:enabled="false"
                            android:visibility="gone"
                            android:textColor="@android:color/white"
                            android:background="@android:color/holo_orange_dark"
                            android:text="Save" />

                        <Button
                            android:id="@+id/save_button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_weight="1"
                            android:background="@android:color/holo_green_dark"
                            android:textColor="@android:color/white"
                            android:enabled="false"
                            android:visibility="gone"
                            android:text="Save" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/settings_doctor_name_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="Doctor Name"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <!--<EditText
                            android:id="@+id/settings_doctor_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:importantForAutofill="no"
                            android:maxLength="25"
                            android:padding="@dimen/_5sdp"
                            android:background="@color/colorPrimaryLight"
                            android:textSize="@dimen/_14sdp" />-->

                        <!--<com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/fullName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:background="@color/colorPrimaryLight"
                            android:visibility="visible">-->

                            <EditText
                                android:id="@+id/settings_doctor_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableTint="@color/colorPrimary"
                                android:enabled="true"
                                android:hint="Doctor Name"
                                android:background="@drawable/btn_roundedrect_primary_light"
                                android:paddingLeft="@dimen/_16sdp"
                                android:paddingRight="@dimen/_16sdp"
                                android:paddingBottom="@dimen/_12sdp"
                                android:paddingTop="@dimen/_12sdp"
                                android:inputType="textCapWords"
                                android:imeOptions="actionNext"
                                android:textColor="@color/black"
                                android:textColorHint="@color/gray"
                                android:textSize="@dimen/_13sdp" />

                        <!--</com.google.android.material.textfield.TextInputLayout>-->

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/_4sdp">

                        <TextView
                            android:id="@+id/settings_doctor_website_lable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="Hospital Name"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <EditText
                            android:id="@+id/settings_doctor_website"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableTint="@color/colorPrimary"
                            android:enabled="true"
                            android:hint="Hospital Name"
                            android:background="@drawable/btn_roundedrect_primary_light"
                            android:paddingLeft="@dimen/_16sdp"
                            android:paddingRight="@dimen/_16sdp"
                            android:paddingBottom="@dimen/_12sdp"
                            android:paddingTop="@dimen/_12sdp"
                            android:inputType="textCapWords"
                            android:imeOptions="actionNext"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray"
                            android:textSize="@dimen/_13sdp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:visibility="gone"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/settings_doctor_contactno_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/doctor_contactno_label"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <EditText
                            android:id="@+id/settings_doctor_contactno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLength="14"
                            android:background="@color/colorPrimaryLight"
                            android:padding="@dimen/_5sdp"
                            android:textSize="@dimen/_14sdp" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/settings_doctor_address_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="Address"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <EditText
                            android:id="@+id/settings_doctor_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableTint="@color/colorPrimary"
                            android:enabled="true"
                            android:maxLines="3"
                            android:hint="Address"
                            android:background="@drawable/btn_roundedrect_primary_light"
                            android:paddingLeft="@dimen/_16sdp"
                            android:paddingRight="@dimen/_16sdp"
                            android:paddingBottom="@dimen/_12sdp"
                            android:paddingTop="@dimen/_12sdp"
                            android:inputType="textCapWords|textMultiLine"
                            android:imeOptions="actionDone"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray"
                            android:textSize="@dimen/_13sdp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/settings_doctor_email_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/doctor_email_label"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <EditText
                            android:id="@+id/settings_doctor_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:importantForAutofill="no"
                            android:inputType="textEmailAddress"
                            android:maxLength="17"
                            android:background="@color/colorPrimaryLight"
                            android:padding="@dimen/_5sdp"
                            android:textSize="@dimen/_14sdp"
                            tools:ignore="LabelFor" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/settings_log_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:gravity="center|start"
                            android:padding="@dimen/_5sdp"
                            android:text="@string/log_label"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_14sdp" />

                        <Spinner
                            android:id="@+id/spinner_log"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="@dimen/_5sdp"
                            android:background="@color/colorPrimaryLight"
                            android:textSize="@dimen/_14sdp" />

                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/settings_save"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/save"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_roundedrect_blue"
                    android:textSize="@dimen/_16sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/scrollabaleContent" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>