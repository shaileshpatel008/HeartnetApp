    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_100sdp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/header_left_btn"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_gravity="center_vertical"
                android:backgroundTint="@color/white"
                android:foregroundTint="@color/white"
                android:padding="6dp"
                android:src="@drawable/backs"
                app:tint="@color/colorWhite" />

            <TextView
                android:id="@+id/header_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_minus16sdp"
                android:gravity="top|center_horizontal"
                android:text="REPORTS"
                android:textColor="@color/white"
                android:fontFamily="@font/regular"
                android:textSize="@dimen/_18sdp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_minus30sdp"
        android:background="@drawable/round_rect_header"
        android:paddingTop="@dimen/_10sdp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_rect_search"
            android:layout_marginLeft="@dimen/_20sdp"
            android:layout_marginRight="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/_15sdp"
                android:paddingRight="@dimen/_15sdp"
                android:paddingBottom="@dimen/_10sdp"
                android:paddingTop="@dimen/_10sdp"
                android:background="@null"
                android:hint="Search by name"
                />
        </LinearLayout>


        <ListView
            android:id="@+id/file_names_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:divider="@null">

        </ListView>

        <TextView
            android:id="@+id/tvNoReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_minus16sdp"
            android:gravity="top|center_horizontal"
            android:text="No reports generated"
            android:textColor="@color/black"
            android:fontFamily="@font/regular"
            android:visibility="gone"
            android:textSize="@dimen/_18sdp" />

    </LinearLayout>

    <com.gauravk.bubblenavigation.BubbleNavigationLinearView
        android:id="@+id/equal_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginLeft="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_rect_white"
        android:elevation="8dp"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.gauravk.bubblenavigation.BubbleToggleView
            android:id="@+id/m_item_shop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:bt_colorActive="@color/colorPrimary"
            app:bt_colorInactive="@color/default_inactive"
            app:bt_icon="@drawable/ic_home_new"
            app:bt_shape="@drawable/menu_background_stroke"
            app:bt_title="Home" />

        <com.gauravk.bubblenavigation.BubbleToggleView
            android:id="@+id/m_item_photos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:bt_colorActive="@color/colorPrimary"
            app:bt_colorInactive="@color/default_inactive"
            app:bt_icon="@drawable/ic_reports_new"
            app:bt_shape="@drawable/menu_background_stroke"
            app:bt_title="Reports" />

        <com.gauravk.bubblenavigation.BubbleToggleView
            android:id="@+id/m_item_call"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:bt_colorActive="@color/colorPrimary"
            app:bt_colorInactive="@color/default_inactive"
            app:bt_icon="@drawable/ic_settings"
            app:bt_shape="@drawable/menu_background_stroke"
            app:bt_title="Accounts" />

    </com.gauravk.bubblenavigation.BubbleNavigationLinearView>

</LinearLayout>